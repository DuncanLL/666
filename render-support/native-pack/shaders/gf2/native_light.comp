#version 430
// Native lib/sky_light.glsl + default lib/land_light.glsl -> Unity's packed SH9.
// The source frame uses the existing camera-relative X/Z flip, no artistic parameters.
layout(local_size_x=1)in;
uniform sampler2D nativeSkyTexture;
layout(std430,binding=0)buffer GF2NativeLighting{vec4 sourceSH[7];vec4 sourceMain;};
uniform vec3 nativeRelativeSky;
uniform float nativePrimaryStrength;
uniform vec4 nativeEngineLight;
void main(){
    vec4 nativeSky[10];
    for(int i=0;i<10;i++)nativeSky[i]=texelFetch(nativeSkyTexture,ivec2(i,0),0);
    const float k0=3.141593*0.282095,k1=2.094395*0.488603;
    const float k2=0.785398*1.092548,k6=0.785398*0.315392,k8=0.785398*0.546274;
    float share=nativeEngineLight.a;
    // Exact Native default skyPartOf / shadeShared ambient split, without its material BRDF.
    vec3 skyPart=min(max(nativeEngineLight.rgb,vec3(0)),max(nativeRelativeSky-(1-share)*(16.0*15.0/255.0),vec3(0)));
    vec3 scale=skyPart*share/max(nativeSky[9].a,1e-9);
    vec3 isotropic=max(nativeEngineLight.rgb-skyPart*share,vec3(0));
    vec3 constant=k0*nativeSky[0].rgb-k6*nativeSky[6].rgb;
    vec3 dx=k8*nativeSky[8].rgb,dy=3.0*k6*nativeSky[6].rgb,dz=-dx;
    vec3 diagonal=(dx+dy)*0.5;
    for(int c=0;c<3;c++){
        sourceSH[c]=vec4(-k1*nativeSky[3][c],k1*nativeSky[1][c],-k1*nativeSky[2][c],constant[c]+diagonal[c])*scale[c]+vec4(0,0,0,isotropic[c]);
        sourceSH[c+3]=vec4(-k2*nativeSky[7][c],-k2*nativeSky[5][c],dz[c]-diagonal[c],k2*nativeSky[4][c])*scale[c];
    }
    sourceSH[6]=vec4((dx-dy)*0.5*scale,1.0);
    sourceMain=vec4(nativeSky[9].rgb*max(nativeRelativeSky,vec3(0))/max(nativeSky[9].a,1e-9)*smoothstep(0.02,0.04,nativePrimaryStrength),1.0);
}
