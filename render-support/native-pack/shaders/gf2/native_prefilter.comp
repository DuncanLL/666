#version 430
#include "gf2/cube_faces.glsl"
// Karis, Real Shading in UE4 (SIGGRAPH 2013), split-sum GGX radiance convolution.
// GF2's actual skin consumer uses LOD=RMO.r*6, not Unity's optional 1.7/.7 remapping.
layout(local_size_x=8,local_size_y=8)in;
layout(rgba16f,binding=0)writeonly uniform imageCube filteredCube;
uniform samplerCube nativeRawCube;
uniform float sourcePerceptualRoughness;
const uint SAMPLE_COUNT=128u;
const float PI=3.141592653589793;
shared vec3 sampleH[128];
void main(){
    ivec3 at=ivec3(gl_GlobalInvocationID);int side=imageSize(filteredCube).x;
    // Roughness and sample directions are identical for all 64 texels in this group.
    float a=sourcePerceptualRoughness*sourcePerceptualRoughness,a2=a*a;
    for(uint i=gl_LocalInvocationIndex;i<SAMPLE_COUNT;i+=64u){
        float u=float(bitfieldReverse(i))*2.3283064365386963e-10,phi=2*PI*float(i)/float(SAMPLE_COUNT);
        float c=sqrt((1-u)/(1+(a2-1)*u)),s=sqrt(max(1-c*c,0));
        sampleH[i]=vec3(cos(phi)*s,sin(phi)*s,c);
    }
    barrier();
    if(at.x>=side||at.y>=side||at.z>=6)return;
    vec3 n=normalize(cubeDirection(at.z,(vec2(at.xy)+.5)/float(side)*2-1));
    vec3 axis=abs(n.z)<.999?vec3(0,0,1):vec3(1,0,0),t=normalize(cross(axis,n)),b=cross(n,t);
    vec3 sum=vec3(0);float weights=0;
    for(uint i=0u;i<SAMPLE_COUNT;i++){
        vec3 h=t*sampleH[i].x+b*sampleH[i].y+n*sampleH[i].z,l=2*dot(n,h)*h-n;
        float w=max(dot(n,l),0);if(w>0){sum+=textureLod(nativeRawCube,l,0).rgb*w;weights+=w;}
    }
    imageStore(filteredCube,at,vec4(sum/max(weights,1e-9),1));
}
