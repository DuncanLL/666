#version 430
// Source MRT2 now contains Native UV motion and the original interpolated previous clip W.
// Only valid original source outputs replace Native velocity; other scene pixels are retained.
layout(local_size_x=16,local_size_y=16)in;
uniform sampler2D sourceNativeMotion;
layout(rgba16f,binding=0)uniform image2D nativeVelocity;
layout(rgba16f,binding=1)uniform image2D nativeNormals;
layout(rgba16f,binding=2)uniform image2D originalNormals;
uniform int initializeNormals;
uniform sampler2D gf2TransferLut;
uniform float gf2TransferExposure;
uniform int gf2TransferOn;
uniform float gf2TransferStrength;
uniform sampler2D gf2TransferOwnership;
layout(rgba16f,binding=3)uniform image2D gf2TransferColour;
vec3 originalDisplayInput(vec3 rgb){
    vec3 p=clamp(log2(max(rgb,vec3(0.0))*5.555556+0.047996)*0.0735+0.386036,0.0,1.0)*31.0;
    float layer=floor(p.b);vec2 uv=(vec2(layer*32.0+p.r,p.g)+0.5)/vec2(1024,32);
    vec3 a=textureLod(gf2TransferLut,uv,0).rgb,b=textureLod(gf2TransferLut,uv+vec2(1.0/32.0,0),0).rgb;
    return mix(a,b,p.b-layer);
}
vec3 decodeOct(vec2 e){
    e=e*2.0-1.0;vec3 n=vec3(e,1.0-abs(e.x)-abs(e.y));
    if(n.z<=0.0)n.xy=(1.0-abs(n.yx))*vec2(n.x>=0.0?1.0:-1.0,n.y>=0.0?1.0:-1.0);
    return normalize(n);
}
vec2 encodeOct(vec3 n){
    n/=max(abs(n.x)+abs(n.y)+abs(n.z),1e-6);
    if(n.z<0.0)n.xy=(1.0-abs(n.yx))*vec2(n.x>=0.0?1.0:-1.0,n.y>=0.0?1.0:-1.0);
    return n.xy*.5+.5;
}
void main(){
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(nativeVelocity);
    if(any(greaterThanEqual(pixel,size)))return;
    vec4 normal=imageLoad(nativeNormals,pixel);
    if(initializeNormals!=0){
        // Original partial MRT1 channel writes preserve the scene normal underneath.
        vec3 sourceNormal=normal.xyz*vec3(-1,1,-1);
        vec2 encoded=dot(sourceNormal,sourceNormal)>1e-6?encodeOct(sourceNormal):vec2(0.5);
        imageStore(originalNormals,pixel,vec4(encoded,0,0));
        return;
    }
    vec4 motion=texelFetch(sourceNativeMotion,pixel,0);
    if(motion.w>.5&&motion.z>0.0&&!any(isnan(motion))&&!any(isinf(motion)))imageStore(nativeVelocity,pixel,motion);
    vec4 original=imageLoad(originalNormals,pixel);
    // These are original OctWorldNormal tags, not eye/material tags in another component.
    if(abs(original.z-.498)<.0003||abs(original.z-.499)<.0003){
        normal.xyz=decodeOct(original.xy)*vec3(-1,1,-1);
        imageStore(nativeNormals,pixel,normal);
    }
    // MRT1 was initialized with z=w=0 outside the actual original-character draws.
    // Apply once after all original colour/stencil phases, never to shadow factors or the background.
    if(gf2TransferOn!=0){
        bool ownsOpaque=abs(texelFetch(gf2TransferOwnership,pixel,0).a-31.0/255.0)<0.5/255.0;
        if(ownsOpaque&&(abs(original.z)>.0001||abs(original.w)>.0001)){
            vec4 colour=imageLoad(gf2TransferColour,pixel);
            float exposure=max(gf2TransferExposure,1e-8);
            if(max(colour.r,max(colour.g,colour.b))>1e-8)colour.rgb=mix(colour.rgb,originalDisplayInput(colour.rgb*exposure)/exposure,clamp(gf2TransferStrength,0.0,1.0));
            imageStore(gf2TransferColour,pixel,colour);
        }
    }
}
